rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Parcels collection
    match /parcels/{parcelId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Claims collection
    match /claims/{claimId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Staff Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Gate Pricing and General Configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
